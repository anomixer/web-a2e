{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "packaged",
  "description": "The same permissions for the packaged app, which the window loads from its own local server (see src/lib.rs)",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:47123"
    ]
  },
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:app:default",
    "core:window:default",
    "core:window:allow-set-title",
    "dialog:default",
    "fs:default",
    "opener:default",
    "opener:allow-open-url"
  ]
}
